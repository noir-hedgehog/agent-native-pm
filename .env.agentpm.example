# AgentPM production runtime. Copy to .env.agentpm and keep it outside git.
AGENTPM_VERSION=0.2.0
AGENTPM_STORE=sqlite
AGENTPM_SQLITE_PATH=/data/agentpm.sqlite3
AGENTPM_AGENT_PROVIDER=openclaw
AGENTPM_ALLOWED_ORIGINS=http://100.79.187.62:8080
AGENTPM_LOG_FORMAT=json
AGENTPM_ASYNC_WEBHOOK=1
AGENTPM_TIMEOUT_POLL_SECONDS=300
AGENTPM_ADMIN_TOKEN=replace-with-a-random-admin-token

PLANE_WEBHOOK_SECRET=replace-with-a-random-secret
PLANE_API_BASE_URL=http://api:8000
PLANE_WORKSPACE_SLUG=agentpm
PLANE_API_TOKEN=replace-with-hekate-plane-token
PLANE_STATUS_FIELD=state
PLANE_STATUS_MAP={}

OPENCLAW_BASE_URL=http://host.docker.internal:3001
OPENCLAW_TOKEN=
OPENCLAW_API_KEY=
OPENCLAW_EVENT_TIMEOUT_SECONDS=900
OPENCLAW_EVENT_POLL_SECONDS=2
